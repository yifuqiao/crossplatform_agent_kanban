{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "Task|Agent|mcp__.*__set_thread_resolved", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.js\" hook claude-code", "timeout": 5 }] }]
  }
}
