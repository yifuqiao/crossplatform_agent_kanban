# /etc/agent-kanban.env — must be root:root 0600.
# systemd reads EnvironmentFile as root before DynamicUser drops privileges.
# Never commit real values.
AKB_HOST=127.0.0.1
PORT=7311
# Public URL is https://relay.onetopway.com/kanban/
AKB_BASE_PATH=/kanban
# Created by systemd StateDirectory=agent-kanban (do not mkdir by hand).
AKB_DATA_DIR=/var/lib/agent-kanban
# Required — serve refuses to start if unset/empty.
AKB_TOKEN=<new random value: openssl rand -hex 24>

# Grok relay on the same server, over loopback. Use the caller keys whose tasks should show up
# (RELAY_API_KEY and/or values from RELAY_CLIENT_KEYS), comma separated.
GROK_RELAY_URL=http://127.0.0.1:8787
GROK_RELAY_KEYS=<caller keys>

# Optional
# CURSOR_API_KEY=<cursor api key>
# CURSOR_WEBHOOK_SECRET=<secret>
