# Serve the board at https://relay.onetopway.com/kanban/ inside the EXISTING relay site.
#
# Add BOTH handle blocks below inside the existing relay.onetopway.com { ... } site.
# Put /WW_verify_* ABOVE /kanban*. Leave every existing line of that site exactly as it is.
# Do not create a second relay.onetopway.com site. Do not touch any other site.
# After editing: caddy validate → caddy reload --config <Caddyfile> --adapter caddyfile
# (caddy.service has no ExecReload — do NOT systemctl restart/reload caddy).
#
# Verify files live in /opt/agent-kanban-verify (root:root 755); only WW_verify_*.txt for app 1000030.
# The board strips /kanban itself (AKB_BASE_PATH=/kanban), so no URI rewriting is needed.

	handle /WW_verify_* {
		root * /opt/agent-kanban-verify
		file_server
	}

	handle /kanban* {
		reverse_proxy 127.0.0.1:7311
	}
