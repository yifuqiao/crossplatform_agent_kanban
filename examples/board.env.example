# Copy to a private env file and load it before `akb serve`. Never commit real values.
# PORT=7311
# AKB_HOST=127.0.0.1
# AKB_DATA_DIR=/home/you/.agent-kanban   (default: ~/.agent-kanban)
# AKB_POLL_SECONDS=30

# Required as soon as the board is reachable beyond localhost (tunnel, LAN, VPS).
# AKB_TOKEN=<long-random-string>

# Cursor cloud agents: poll https://api.cursor.com for all your agents.
# CURSOR_API_KEY=<cursor-api-key>
# Optional: verify Cursor statusChange webhooks sent to /webhooks/cursor.
# CURSOR_WEBHOOK_SECRET=<secret>

# Grok Bot: poll grok-bot-task-relay with one or more caller keys (comma separated).
# GROK_RELAY_URL=https://relay.example.com
# GROK_RELAY_KEYS=<claude-caller-key>,<wecom-caller-key>
