    "Notification": [{ "hooks": [{ "type": "command", "command": "akb hook claude-code", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "akb hook claude-code", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "akb hook claude-code", "timeout": 5 }] }]
